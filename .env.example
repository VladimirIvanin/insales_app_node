# Обязательные параметры
INSALES_APP_ID=
INSALES_APP_SECRET=
APP_BASE_URL=https://app.example.com
APP_ENCRYPTION_KEY=

# Режим: development / test / production
APP_ENV=development

# Точные домены магазинов через запятую
ALLOWED_SHOPS=

# Путь к runtime-каталогу (по умолчанию runtime/)
# APP_RUNTIME_DIR=runtime

# Имя или путь к SQLite (относительно runtime или абсолютный)
# APP_DB=app.sqlite3

# Адрес HTTP-сервера
# BIND_HOST=127.0.0.1
# PORT=8765

# Уровень логирования
# LOG_LEVEL=info

# Адреса или CIDR доверенных прокси через запятую.
# Число hops не принимается: без адреса прокси заголовок X-Forwarded-For не используется.
# TRUST_PROXY=127.0.0.1

# Разрешить HTTP для loopback-симулятора (только development/test)
# LOCAL_DEMO=false