{
  "name": "insales_app_node",
  "version": "1.0.0",
  "description": "Заготовка устанавливаемого партнёрского приложения InSales на Node.js.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "audit": "npm audit --audit-level=high",
    "dev:keygen": "tsx src/cli.ts keygen",
    "dev:doctor": "tsx src/cli.ts doctor",
    "dev:cleanup": "tsx src/cli.ts cleanup",
    "dev:db:migrate": "tsx src/cli.ts db:migrate",
    "dev:db:status": "tsx src/cli.ts db:status",
    "keygen": "node dist/cli.js keygen",
    "db:migrate": "node dist/cli.js db:migrate",
    "db:status": "node dist/cli.js db:status",
    "doctor": "node dist/cli.js doctor",
    "cleanup": "node dist/cli.js cleanup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VladimirIvanin/insales_app_node.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/VladimirIvanin/insales_app_node/issues"
  },
  "homepage": "https://github.com/VladimirIvanin/insales_app_node#readme",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/csrf-protection": "^8.0.2",
    "@fastify/formbody": "^9.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fastify/view": "^12.0.1",
    "better-sqlite3": "^13.0.3",
    "ejs": "^7.0.2",
    "fastify": "^5.12.7",
    "typebox": "^1.4.3",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript-eslint": "^8.72.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
